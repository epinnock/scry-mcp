{
  "name": "scry-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "SCRY_ENV": "production",
    // AI credits: ENFORCE in production (2026-09-24, founder skipped the shadow week;
    // rollback "shadow" or "off"). generate_image holds 40/150 on the caller's wallet in the
    // production diff-service ledger; secrets CREDITS_API_TOKEN (= production
    // diff SERVICE_AUTH_TOKEN) and FIREBASE_CLIENT_EMAIL/FIREBASE_PRIVATE_KEY.
    "CREDITS_MODE": "enforce",
    "CREDITS_API_URL": "https://scry-diff-service-production.epinnock.workers.dev",
    "CREDITS_PAGE_URL": "https://dashboard.scrymore.com/credits",
    // llm-telemetry ON in production (Gate B 2026-09-24, "turn everything on"): Gemini calls go
    // through the authenticated scry-prod AI Gateway (needs the CF_AIG_TOKEN secret = prod run
    // token; delete the line to call Google directly = kill switch). Full Langfuse traces
    // (project scry-prod) via the diff-service production telemetry queue; "0" stops spans.
    "LLM_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/f54b9c10de9d140756dbf449aa124f1e/scry-prod",
    "LANGFUSE_ENABLED": "1",
    "LANGFUSE_SAMPLE_RATE": "1",
    // Issue resolution ON in production (Gate B 2026-09-25, "ship it"): the six issue tools call
    // the production dashboard's /api/agent/issues/* with a signed X-Scry-Caller (aud
    // scry-dashboard-agent, secret SCRY_AGENT_ASSERTION_SECRET = dashboard prod value).
    // No bypass token in production. Kill switch: set ISSUE_TOOLS_ENABLED to "0" (tools off
    // unless exactly "1").
    "ISSUE_TOOLS_ENABLED": "1",
    "SCRY_DASHBOARD_API_URL": "https://dashboard.scrymore.com"
  },
  // Producer only: the consumer is scry-diff-service-production (src/telemetry/delivery.ts).
  "queues": {
    "producers": [{ "binding": "TELEMETRY_QUEUE", "queue": "scry-telemetry-production" }]
  },
  "build": {
    "command": "npm run build:widgets"
  },
  "assets": {
    "directory": "./web/dist/widgets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "eeef4d48ad254d75bacf09b62782ad7a",
      "preview_id": "458bc39341e74f3baa8913257b54e356"
    }
  ],
  "analytics_engine_datasets": [{ "binding": "MCP_USAGE", "dataset": "scry_mcp_usage" }],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "ScryMCP"
      }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ScryMCP"] }
  ],
  "env": {
    "staging": {
      "name": "scry-mcp-staging",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "SCRY_ENV": "staging",
        // llm-telemetry PR 7. Gemini calls go through the scry-stage AI Gateway
        // (needs the CF_AIG_TOKEN secret). Delete this line to call Google directly.
        "LLM_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/f54b9c10de9d140756dbf449aa124f1e/scry-stage",
        // Full traces for Langfuse, enqueued on the diff-service telemetry queue
        // (its consumer archives to R2 and delivers). "0" stops producing spans.
        "LANGFUSE_ENABLED": "1",
        // Adaptive sampling: the rate is read from the diff-service unit-budget job
        // (GET CREDITS_API_URL/api/telemetry/sampling, bearer CREDITS_API_TOKEN,
        // rates.mcp, cached ttl_s). This var (0..1) is the fallback when that is
        // unavailable or has no evaluation. LANGFUSE_DYNAMIC_SAMPLING="0" = env var only.
        "LANGFUSE_SAMPLE_RATE": "1",
        // AI credits: generate_image holds 40/150 on the caller's wallet in the
        // diff-service ledger (needs the CREDITS_API_TOKEN secret = the stage
        // diff-service SERVICE_AUTH_TOKEN). enforce = refused at zero (402 -> tool error), fails closed on ledger outage.
        "CREDITS_MODE": "enforce", // stage enforces since Stage 5 UAT (2026-09-24)
        "CREDITS_API_URL": "https://scry-diff-service-staging.epinnock.workers.dev",
        "CREDITS_PAGE_URL": "https://dashboard-stage.scrymore.com/credits",
        // Issue resolution (feature issue-resolution item 6): the six issue tools call the
        // stage dashboard's /api/agent/issues/* with a signed X-Scry-Caller (aud
        // scry-dashboard-agent). Stage dashboard is behind Vercel protection: secret
        // SCRY_DASHBOARD_BYPASS_TOKEN. Production keeps the tools off until Gate B.
        "ISSUE_TOOLS_ENABLED": "1",
        "SCRY_DASHBOARD_API_URL": "https://dashboard-stage.scrymore.com"
      },
      // Producer only: the consumer is scry-diff-service-staging (src/telemetry/delivery.ts).
      "queues": {
        "producers": [{ "binding": "TELEMETRY_QUEUE", "queue": "scry-telemetry-staging" }]
      },
      "kv_namespaces": [
        {
          "binding": "OAUTH_KV",
          "id": "8fd3a345500f415a82a5da47b4ae79f1",
          "preview_id": "8fd3a345500f415a82a5da47b4ae79f1"
        }
      ],
      "analytics_engine_datasets": [{ "binding": "MCP_USAGE", "dataset": "scry_mcp_usage_staging" }],
      "durable_objects": {
        "bindings": [
          {
            "name": "MCP_OBJECT",
            "class_name": "ScryMCP"
          }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["ScryMCP"] }
      ]
    }
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
