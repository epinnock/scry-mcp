{
  "name": "scry-mcp",
  "scripts": {
    "build:widgets": "rm -rf web/dist/widgets && INPUT=web/widgets/search-results-widget.html vite build --config vite.config.ts && INPUT=web/widgets/screenshot-widget.html vite build --config vite.config.ts && INPUT=web/widgets/generated-image-widget.html vite build --config vite.config.ts",
    "dev": "npm run build:widgets && wrangler dev",
    "deploy": "npm run build:widgets && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint src/ test/",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage",
    "verify:e2e": "npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.2.0",
    "@modelcontextprotocol/ext-apps": "^1.2.2",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "agents": "^0.0.87",
    "hono": "^4.7.0",
    "jose": "^6.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.8.34",
    "@cloudflare/workers-types": "^4.20250310.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "3.0.9",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.57.0",
    "vite-plugin-singlefile": "^2.3.2",
    "vitest": "3.0.9",
    "wrangler": "^4.0.0"
  }
}
